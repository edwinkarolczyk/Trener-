<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mealWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="11dp"
    android:background="@drawable/diet_widget_bg">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TRENER 2 • SZYBKI POSIŁEK"
        android:textColor="#F36469"
        android:textStyle="bold"
        android:textSize="11sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <TextView android:id="@+id/mealWidgetScan"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:padding="11dp"
            android:layout_marginRight="4dp" android:gravity="center"
            android:text="SKANUJ" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="11sp"
            android:background="@drawable/diet_widget_button"/>
        <TextView android:id="@+id/mealWidgetWrite"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:padding="11dp"
            android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
            android:gravity="center" android:text="WPISZ"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp"
            android:background="@drawable/diet_widget_button"/>
        <TextView android:id="@+id/mealWidgetSet"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:padding="11dp"
            android:layout_marginLeft="4dp" android:gravity="center"
            android:text="ZESTAW" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="11sp"
            android:background="@drawable/diet_widget_button"/>
    </LinearLayout>
</LinearLayout>
