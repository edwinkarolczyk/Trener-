<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/waterWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="13dp"
    android:background="@drawable/diet_widget_bg">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NAWODNIENIE"
        android:textColor="#F36469"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/waterWidgetValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 / 2500 ml"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="21sp"
        android:maxLines="1"/>
    <ProgressBar
        android:id="@+id/waterWidgetProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="5dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="#39D27D"
        android:progressBackgroundTint="#303030"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/waterWidget100"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginRight="4dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:text="+100 ml"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/diet_widget_button"/>
        <TextView
            android:id="@+id/waterWidget250"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:text="+250 ml"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/diet_widget_button"/>
        <TextView
            android:id="@+id/waterWidget500"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:text="+500 ml"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="11sp"
            android:background="@drawable/diet_widget_button"/>
    </LinearLayout>
</LinearLayout>
